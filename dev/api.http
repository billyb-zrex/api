Content-Type: application/json

{}

### projects: get
GET http://localhost:8080/api/v1/projects
Accept: application/json

### project: update
POST http://localhost:8080/api/v1/project/update/5
Content-Type: application/json

{
  "change": [
    {
      "field": "DisplayName",
      "value": "New Name3",
      "type": "Str"
    },
    {
      "field": "Thumbnail",
      "value": "Some Image Content",
      "type": "Img"
    }
  ]
}

